APP_NAME="Talviro Chat API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

# MySQL values from cPanel. Never commit the real .env file.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Mail: configure with your domain mailbox or mail provider.
MAIL_MAILER=smtp
MAIL_HOST=mail.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# SMS OTP provider: provider-specific credentials and endpoint are required.
# Leave disabled until a real SMS provider account is configured.
OTP_DRIVER=disabled
SMS_PROVIDER=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Firebase Cloud Messaging: use a server-side service account/ADC.
# Never put a service-account JSON or private key in Android or GitHub.
FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Object/media storage. For local storage, keep uploads outside executable public paths.
MEDIA_DISK=local
MEDIA_MAX_IMAGE_MB=12
MEDIA_MAX_VIDEO_MB=100
MEDIA_MAX_FILE_MB=25

# WebRTC signaling/ICE. Public STUN alone is not sufficient for reliable calls.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# Optional managed SFU for group calls (e.g. LiveKit); server-side secret only.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Admin audit log HMAC key: generate a random value of 32+ characters.
ADMIN_AUDIT_HASH_KEY=

# Rate limiting / operational defaults
API_RATE_LIMIT_PER_MINUTE=60
